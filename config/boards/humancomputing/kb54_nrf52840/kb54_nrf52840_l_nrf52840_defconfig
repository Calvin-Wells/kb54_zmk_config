# Keyboard IDs
CONFIG_ZMK_KEYBOARD_NAME="KB54"

# Work-around for Windows bug with battery notifications
CONFIG_BT_GATT_ENFORCE_SUBSCRIPTION=n

# The full two-byte consumer report space has compatibility issues with some
# operating systems, most notably macOS. Use the more basic single-byte usage
# space.
CONFIG_ZMK_HID_CONSUMER_REPORT_USAGES_BASIC=y

CONFIG_BT_BAS=y

# Report both halves' battery levels to the host via the central's battery service
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY=y

# Set here rather than Kconfig.defconfig: ZMK's Kconfig.defaults (default 60)
# is read first and would win over a board default.
CONFIG_ZMK_BATTERY_REPORT_INTERVAL=15

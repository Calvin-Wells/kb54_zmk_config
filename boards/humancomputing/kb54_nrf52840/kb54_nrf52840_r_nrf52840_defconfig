# Keyboard IDs
CONFIG_ZMK_KEYBOARD_NAME="KB54 Right"

# Set here rather than Kconfig.defconfig: ZMK's Kconfig.defaults (default 60)
# is read first and would win over a board default.
CONFIG_ZMK_BATTERY_REPORT_INTERVAL=15

# LVGL 9 label drawing and canvas rotation need more stack than the 3072
# default. Set here rather than Kconfig.defconfig: ZMK defines this symbol
# (and its default) first, so a board default would lose.
CONFIG_ZMK_DISPLAY_DEDICATED_THREAD_STACK_SIZE=8192
